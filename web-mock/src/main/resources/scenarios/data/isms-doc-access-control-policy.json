      "value": {
        "title": "Access control policy",
        "owner": "role:ciso",
        "purpose": "Access to systems and data is given to people who need it for their work, and to nobody else. Access of a person who changes the role or leaves is reviewed within a week.",
        "statements": "Access is given by role and reviewed every half year.\n\n* The owner of a system approves every access to it.\n* Privileged access is personal, is logged and is renewed every quarter.\n* The accounts of suppliers end with their project.",
        "applies-to": [
          "team:organisation"
        ],
        "review-due": "2026-12-08",
        "related": [
          "isms-core:policy/01JZB1C3E5G7J9M1P3R5T7W9Y2"
        ]
      }
